# Public read-only API base. Auth always uses /auth on the web origin.
# Vite's development/preview server proxies /auth to AUTH_PROXY_TARGET,
# falling back to VITE_API_BASE. Production hosting needs an equivalent
# same-origin proxy before real login is enabled.
VITE_API_BASE=https://radar-fiscal-backend-production.up.railway.app

# Optional server-only override for the auth proxy target.
AUTH_PROXY_TARGET=https://radar-fiscal-backend-production.up.railway.app


# Temporary visual demo access. Only the exact literal "true" enables it.
VITE_ENABLE_DEMO_ACCESS=false
